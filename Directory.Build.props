<Project>
		<PropertyGroup>
        <Authors>Mike Allan</Authors>
        <TargetFramework>net11.0</TargetFramework>
				<ImplicitUsings>enable</ImplicitUsings>
				<Nullable>enable</Nullable>
				<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
				<CodeAnalysisTreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</CodeAnalysisTreatWarningsAsErrors>

				<!-- Nullable warnings are errors in every configuration, so a non-nullable parameter needs no
				     ThrowIfNull: the compiler already rejects a null argument. -->
				<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>

				<AnalysisLevel>latest</AnalysisLevel>
				<AnalysisMode>Recommended</AnalysisMode>

				<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

				<!-- Disable whitespace rule -->
				<NoWarn>$(NoWarn);IDE0055</NoWarn>

				<!-- Disable "must have curly braces for if/else" -->
				<NoWarn>$(NoWarn);IDE0011</NoWarn>

				<!-- Disable "use auto property" - intentionally using backing fields for validation -->
				<NoWarn>$(NoWarn);IDE0032</NoWarn>
		</PropertyGroup>
</Project>
