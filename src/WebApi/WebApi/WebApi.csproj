<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>MikeAllan.VerticalSliceArchitecture</RootNamespace>
    <PackageId>MikeAllan.VerticalSliceArchitecture</PackageId>
    <UserSecretsId>08ca0468-8c14-44f2-8bb7-ae05d6cdd562</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- dotnet ef uses this project as the startup project; the migrations live in Domain (src/Domain/Domain). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Everything under Internals/ is internal; the tests exercise the request types, endpoints and
       concerns directly, so they see it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WebApi.UnitTests" />
    <InternalsVisibleTo Include="WebApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Domain\Domain\Domain.csproj" />
  </ItemGroup>
</Project>
